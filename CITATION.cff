    given-names: "Flávio L. C."
    affiliation: "Universidade de Brasília"
    orcid: "https://orcid.org/0000-0002-9390-5751"
repository-code: "https://github.com/flaviodemoura/Zprop-nominal"
license: MIT
keywords:
  - Rocq
  - confluence
  - Z property
  - explicit substitutions
  - nominal syntax
  - formal verification
